ructures, the shapes that keep recurring, and animated worked lessons. Not a track to finish — look things up as you need them.'],
      [null, "That's the tour",
       'Basics on your own machine, everything else on LeetCode, marked done here so revision can bring it back at the right moment. You can replay this any time from <b>Take the tour</b> in the account menu.'],
    ];

    const seen = (el) => !!el && !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);
    let loading = null;
    function load() {
      loading = loading || new Promise((resolve, reject) => {
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = tourApp.dataset.tourCss;
        document.head.appendChild(css);
        const js = document.createElement('script');
        js.src = tourApp.dataset.tourJs;
        // The IIFE build hangs its export off window.driver.js.
        js.onload = () => {
          const lib = window.driver && window.driver.js && window.driver.js.driver;
          if (lib) resolve(lib); else reject(new Error('no driver'));
        };
        js.onerror = () => reject(new Error('no driver'));
        document.head.appendChild(js);
      });
      return loading;
    }

    // Finished or dismissed, both mean answered: the tour does not open by
    // itself again. Silent on failure -- the student has just finished a tour,
    // and "could not be saved" is noise about something they cannot act on;
    // the cost of the write being lost is that it opens once more.
    function markSeen() {
      if (!tourApp.hasAttribute('data-tour')) return;
      tourApp.removeAttribute('data-tour');
      fetch('/api/tour/seen', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRFToken': csrf() },
        body: '{}',
      }).catch(() => {});
    }

    function startTour() {
      // Before the visibility filter, not after: a collapsed sidebar would
      // otherwise drop five of the eleven steps for being invisible.
      const restore = revealSidebar ? revealSidebar() : () => {};
      load().then((driver) => {
        const steps = STEPS
          .filter(([sel]) => sel === null || seen(document.querySelector(sel)))
          .map(([sel, title, description]) => ({
            element: sel || undefined,
            popover: { title, description },
          }));
        driver({
          steps,
          popoverClass: 'ck-tour',
          showProgress: true,
          progressText: '{{current}} of {{total}}',
          // Near-black, like .scrim: it reads as dimming in all three themes,
          // where a token colour would have to be re-read per theme.
          overlayColor: '#0B1220',
          overlayOpacity: 0.55,
          nextBtnText: 'Next',
          prevBtnText: 'Back',
          doneBtnText: 'Done',
          animate: !matchMedia('(prefers-reduced-motion: reduce)').matches,
          onDestroyed: () => { restore(); markSeen(); },
        }).drive();
      }).catch(() => {
        restore();
        toast('The tour could not be loaded.', 'alert', 'error');
      });
    }

    tourBtn.addEventListener('click', () => {
      // The account menu is a <details> above the overlay; leaving it open
      // would cover the first step.
      document.getElementById('acct')?.removeAttribute('open');
      startTour();
    });
    if (tourApp.hasAttribute('data-tour')) startTour();
  }

  /* ── Password fields: Show/Hide, and the live rule list ─────────────── */
  document.addEventListener('click', (e) => {
    const b = e.target.closest('[data-pw-toggle]');
    if (!b) return;
    const input = b.closest('.input-group')?.querySelector('input');
    if (!input) return;
    const show = input.type === 'password';
    input.type = show ? 'text' : 'password';
    b.textContent = show ? 'Hide' : 'Show';
    b.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
  });
  const PW_RULES = { len: (v) => v.length >= 8, up: (v) => /[A-Z]/.test(v), lo: (v) => /[a-z]/.test(v), dg: (v) => /[0-9]/.test(v) };
  document.querySelectorAll('[data-pw-rules]').forEach((ul) => {
    const input = document.getElementById(ul.dataset.pwRules);
    if (!input) return;
    const paint = () => ul.querySelectorAll('li').forEach((li) => li.classList.toggle('ok', PW_RULES[li.dataset.r](input.value)));
    input.addEventListener('input', paint);
    paint();
  });

  /* ── Catalogue filters: ref_render.js toggles `.pill.active`; keep the
     pressed state a screen reader hears in step with it. Runs after the
     group's own handler, which is bound on the group and so fires first. */
  const syncPills = (group) => group.querySelectorAll('.pill').forEach((p) => p.setAttribute('aria-pressed', String(p.classList.contains('active'))));
  document.querySelectorAll('.seg .pill').forEach((p) => syncPills(p.parentElement));
  document.addEventListener('click', (e) => { const p = e.target.closest('.seg .pill'); if (p) syncPills(p.parentElement); });

  /* ── Search: `?focus=1` and the search shortcut land in the page's search ── */
  if (new URLSearchParams(location.search).get('focus')) {
    window.addEventListener('load', () => document.querySelector('[data-search]')?.focus());
  }

  /* ── Revision Queue (PLAN-114/115/128) ──────────────────────────────── */
  // Rating a card posts in the background and slides it away; the page's
  // counts and the sidebar badge drop by one, because a removed card was
  // always counted in each. On any failure the form posts normally.
  document.addEventListener('submit', (e) => {
    const form = e.target;
    if (!form.classList.contains('revision-action-form')) return;
    e.preventDefault();
    const card = form.closest('[data-rev-item]');
    fetch(form.action, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: new FormData(form) })
      .then((res) => { if (!res.ok) throw new Error('revision action failed'); return res.json(); })
      .then(() => {
        const wasOverdue = card && card.dataset.overdue === '1';
        const msg = form.dataset.toast || 'Saved';
        const dec = (el) => { if (!el) return 0; const n = Math.max(0, parseInt(el.textContent, 10) - 1); el.textContent = n; return n; };
        dec(document.getElementById('revision-count'));
        if (wasOverdue) {
          const left = dec(document.getElementById('revision-overdue-count'));
          if (left === 0) document.getElementById('revision-overdue-chip')?.setAttribute('hidden', '');
        }
        const badge = document.getElementById('nav-revision-badge');
        if (badge && dec(badge) === 0) badge.remove();
        const finish = () => {
          const next = card?.nextElementSibling;
          card?.remove();
          const list = document.getElementById('revision-list');
          if (list && !list.querySelector('[data-rev-item]')) {
            list.hidden = true;
            document.getElementById('revision-empty')?.removeAttribute('hidden');
          } else next?.querySelector('button')?.focus();
        };
        if (card) { card.classList.add('leaving'); setTimeout(finish, 260); } else finish();
        toast(msg, form.dataset.icon || 'check');
      })
      .catch(() => form.submit());
  });

  /* ── Copy the profile link (PLAN-109 G6) ────────────────────────────── */
  document.addEventListener('click', (e) => {
    const b = e.target.closest('[data-share]');
    if (!b) return;
    const url = b.dataset.share;
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(url).then(() => toast(b.dataset.shareLabel || 'Profile link copied', 'link')).catch(() => window.prompt('Copy this link:', url));
    } else {
      // The clipboard API needs a secure context, which a LAN deployment over
      // plain http is not.
      window.prompt('Copy this link:', url);
    }
  });

  /* ── Pick-many tables: select all, and a live count (PLAN-142) ──────── */
  // A header box `[data-check-all="<name>"]` ticks every box of that name in
  // its form; `[data-check-count]` in the same form says how many are ticked.
  document.addEventListener('change', (e) => {
    const form = e.target.form;
    if (!form || e.target.type !== 'checkbox') return;
    const name = e.target.dataset.checkAll || e.target.name;
    const master = form.querySelector(`[data-check-all="${name}"]`);
    if (!master) return;
    const boxes = [...form.querySelectorAll(`input[type="checkbox"][name="${name}"]`)];
    if (e.target === master) boxes.forEach((b) => { b.checked = master.checked; });
    const n = boxes.filter((b) => b.checked).length;
    master.checked = n > 0 && n === boxes.length;
    master.indeterminate = n > 0 && n < boxes.length;
    form.querySelectorAll('[data-check-count]').forEach((el) => { el.textContent = `${n} selected`; });
  });

  /* ── Mail preview: the To line follows the row shown (PLAN-142) ─────── */
  // The row's link loads the frame by `target`, with or without this script;
  // this only keeps the To line in step and brings a stacked frame into view.
  document.addEventListener('click', (e) => {
    const a = e.target.closest('[data-preview-to]');
    if (!a) return;
    document.querySelectorAll('[data-preview-to-target]').forEach((el) => { el.textContent = a.dataset.previewTo; });
    document.querySelector(`iframe[name="${a.target}"]`)?.scrollIntoView({ block: 'nearest' });
  });

  /* ── Lesson frame: rating (PLAN-114 G4) ─────────────────────────────── */
  // The lesson is served byte-for-byte in a sandboxed frame and cannot carry a
  // control, so the page bar is where a student says how it went -- which is
  // also what marks it done.
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.rate [data-outcome]');
    if (!btn) return;
    const box = btn.closest('.rate');
    const state = box.querySelector('.rate-state');
    box.querySelectorAll('[data-outcome]').forEach((b) => { b.disabled = true; });
    fetch('/api/revision/rate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRFToken': csrf() },
      body: JSON.stringify({ problem_id: box.dataset.problemId, outcome: btn.dataset.outcome }),
    })
      .then((res) => res.json().then((d) => { if (!res.ok || d.ok === false) throw new Error(d.message || d.error || res.status); return d; }))
      .then((d) => {
        if (d.completed) { state.textContent = 'Done · reviewed to the end'; toast('Marked done — reviewed to the end of the ladder'); return; }
        const when = new Date(d.next_review_at + 'T00:00:00').toLocaleDateString(undefined, { day: '2-digit', month: 'short' });
        state.textContent = 'Done · next review ' + when;
        toast('Marked done — next review ' + when);
      })
      .catch((err) => { state.textContent = 'Not saved (' + err.message + ')'; toast('Not saved — ' + err.message, 'alert', 'error'); })
      .finally(() => box.querySelectorAll('[data-outcome]').forEach((b) => { b.disabled = false; }));
  });

  /* ── Registration: live validation ──────────────────────────────────── */
  // Mirrors app/auth.py (EMAIL_RE, password_errors(), parse_date_of_birth())
  // so a student sees the complaint before submitting. UX only: the form is
  // `novalidate` and the server re-checks everything.
  (function () {
    const form = document.getElementById('register-form');
    if (!form) return;
    const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
    function passwordMessage(p) {
      const missing = [];
      if ((p || '').length < 8) missing.push('at least 8 characters');
      if (!/[A-Z]/.test(p)) missing.push('one uppercase letter');
      if (!/[a-z]/.test(p)) missing.push('one lowercase letter');
      if (!/[0-9]/.test(p)) missing.push('one number');
      return missing.length ? 'Password must contain ' + missing.join(', ') + '.' : '';
    }
    function show(field, message) {
      const el = document.getElementById('err-' + field);
      if (el) el.textContent = message || '';
      form.elements[field]?.setAttribute('aria-invalid', String(!!message));
      return !message;
    }
    const v = {
      name: () => show('name', form.name.value.trim() ? '' : 'Name is required.'),
      email: () => show('email', EMAIL_RE.test(form.email.value.trim()) ? '' : 'Enter a valid email address.'),
      date_of_birth: () => {
        const raw = form.date_of_birth.value;
        if (!raw) return show('date_of_birth', 'Date of birth is required.');
        const today = new Date(); today.setHours(0, 0, 0, 0);
        return show('date_of_birth', new Date(raw + 'T00:00:00') > today ? 'Date of birth cannot be in the future.' : '');
      },
      password: () => show('password', passwordMessage(form.password.value)),
      confirm_password: () => show('confirm_password', form.confirm_password.value === form.password.value ? '' : 'Passwords do not match.'),
    };
    Object.keys(v).forEach((f) => {
      const el = form.elements[f];
      el.addEventListener('blur', v[f]);
      el.addEventListener('input', () => {
        if (document.getElementById('err-' + f).textContent) v[f]();
        if (f === 'password' && form.confirm_password.value) v.confirm_password();
      });
    });
    form.addEventListener('submit', (e) => {
      let first = null;
      Object.keys(v).forEach((f) => { if (!v[f]() && !first) first = form.elements[f]; });
      if (first) { e.preventDefault(); first.focus(); }
    });
  })();

  /* ── Grind: the clock and the pace ring (PLAN-121 G2/G4) ────────────── */
  // Both numbers are DISPLAYS: the server recomputes the remaining time from
  // GrindRun.Ends_At on every request, so editing data-remaining changes what
  // this page says and nothing about when the run ends. Auto-advance is a
  // convenience for the same reason -- if it never fires, the server still
  // credits the real elapsed time.
  (function () {
    const stage = document.querySelector('[data-grind-run]');
    if (!stage) return;
    const clock = document.getElementById('grind-clock');
    const pace = document.getElementById('grind-pace');
    const paceT = document.getElementById('grind-pace-t');
    const skip = document.getElementById('grind-skip');
    let remaining = parseInt(stage.dataset.remaining, 10);
    const budget = parseInt(stage.dataset.budget, 10);
    if (!Number.isFinite(remaining)) return;
    let onThisOne = 0, autoAdvanced = false;
    const mmss = (t) => { t = Math.max(0, t); return Math.floor(t / 60) + ':' + String(t % 60).padStart(2, '0'); };
    const paint = () => {
      clock.textContent = mmss(remaining);
      clock.classList.toggle('is-low', remaining <= 300);
      if (pace && Number.isFinite(budget)) {
        paceT.textContent = mmss(onThisOne);
        pace.querySelector('.ring').style.setProperty('--p', Math.min(100, (onThisOne / budget) * 100));
        pace.classList.toggle('is-over', onThisOne >= budget);
      }
    };
    paint();
    setInterval(() => {
      remaining -= 1; onThisOne += 1;
      if (remaining <= 0) { window.location.reload(); return; }
      // Once per problem, and only by SKIPPING: running out of budget is not
      // the same fact as giving up.
      if (!autoAdvanced && skip && Number.isFinite(budget) && onThisOne >= budget) { autoAdvanced = true; skip.click(); return; }
      paint();
    }, 1000);
    const act = (id) => () => document.querySelector(`[data-grind-action="${id}"]`)?.click();
    addKeys('Grind run', [
      { keys: 's', label: 'Solved it', run: act('solved') },
      { keys: 'q', label: 'Gave up', run: act('gave_up') },
      { keys: 'n', label: 'Skip — come back to it', run: act('skip') },
    ]);
  })();

  /* ── Landing: staged reveals and the climb's rail ───────────────────── */
  // The scrollytelling vocabulary -- reveal on entry, and a pinned rail whose
  // state follows the reader -- done with an IntersectionObserver and
  // `position: sticky`. Deliberately no scroll library: GSAP ScrollTrigger,
  // Locomotive or Lenis would each be a third-party asset on a public page,
  // which tests/test_ui_shell.py forbids and the Privacy Policy's "no third
  // parties on any page" depends on. The smooth-scroll ones also replace
  // native scrolling, which is worst on exactly the phones this page has to
  // work on, and they take find-in-page and scroll-anchoring with them.
  (function () {
    const reveals = document.querySelectorAll('[data-reveal]');
    const steps = document.querySelectorAll('[data-climb-step]');
    if (!reveals.length && !steps.length) return;
    const io = 'IntersectionObserver' in window;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Nothing is hidden until something can un-hide it: with JS off, no
    // observer, or reduced motion, the page renders in its final state. The
    // failure this avoids is a blank landing page, not a missing animation.
    if (io && !still && reveals.length) {
      root.classList.add('reveal-ready');
      const seen = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          seen.unobserve(e.target);
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.15 });
      reveals.forEach((el) => seen.observe(el));
    }

    // The rail marks the rung being read. The margins leave a band across the
    // middle of the viewport, so exactly one step is ever in it, and it tracks
    // in both directions -- scrolling back up returns to the rung you are
    // actually looking at rather than leaving the ladder fully lit.
    const rail = document.querySelector('[data-climb-rail]');
    if (io && rail && steps.length) {
      const onStep = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          rail.dataset.active = e.target.dataset.climbStep;
          // Figures 2-4 stay paused until their step is actually reached, so
          // a scene draws for the reader rather than having finished
          // off-screen. Figure 1 is the exception and plays on load: the stage
          // sits in the first viewport with rung 01 lit by the markup (so a
          // JS-less page draws it too), and paused it would be the empty box
          // the page opens on.
          rail.classList.add('is-live');
        });
      }, { rootMargin: '-45% 0px -45% 0px' });
      steps.forEach((el) => onStep.observe(el));
    }
  })();

  /* ── Page keys ──────────────────────────────────────────────────────── */
  // The catalogue tables (rendered by ref_render.js after this runs, so the
  // lookups are live rather than captured).
  if (document.querySelector('[data-surface]')) {
    const rows = listNav('.prob-row', '.prob-name-link, .bas-name, .status-toggle');
    const onRow = (sel) => () => { const r = rows.focused(); if (!r) return rows.next(); r.querySelector(sel)?.click(); };
    addKeys('Tables', [
      { keys: 'j', label: 'Next row', run: rows.next },
      { keys: 'k', label: 'Previous row', run: rows.prev },
      { keys: 'x', label: 'Mark done, or back to new', run: onRow('.status-toggle') },
      { keys: 'o', label: 'Open the problem', run: onRow('.prob-name-link') },
      { keys: 'l', label: 'Open its lesson', run: onRow('.open-btn') },
    ]);
  }
  if (document.getElementById('revision-list')) {
    const cards = listNav('#revision-list [data-rev-item]', 'h3 a');
    const rate = (kind) => () => { const c = cards.current(); c?.querySelector(`[data-rate="${kind}"]`)?.click(); };
    addKeys('Revision', [
      { keys: 'j', label: 'Next problem', run: cards.next },
      { keys: 'k', label: 'Previous problem', run: cards.prev },
      { keys: 'r', label: 'Rederived it', run: rate('rederived') },
      { keys: 'c', label: 'Needed the code', run: rate('needed_code') },
      { keys: 'x', label: 'Dismiss', run: rate('dismiss') },
    ]);
  }
  if (document.querySelector('[data-row-nav]')) {
    const rows = listNav('[data-row-nav] tbody tr', 'a');
    addKeys('This list', [
      { keys: 'j', label: 'Next row', run: rows.next },
      { keys: 'k', label: 'Previous row', run: rows.prev },
    ]);
  }
  const note = document.querySelector('[data-note-editor]');
  if (note) {
    addKeys('Notes', [{ keys: 'e', label: 'Edit the note', run: () => note.focus() }]);
    note.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') { e.preventDefault(); note.form.requestSubmit(); }
      if (e.key === 'Escape') note.blur();
    });
  }

  // Global keys, registered after the page's so the ? dialog lists the page first.
  addKeys('General', [
    { keys: '/', label: 'Search', run: () => {
      const s = document.querySelector('[data-search]');
      if (s) { s.focus(); s.select?.(); return; }
      // No search on this page: Problems' own (PLAN-138 retired the app bar's).
      const p = document.querySelector('[data-nav-id="problems"]');
      if (p) location.href = p.href + (p.href.includes('?') ? '&' : '?') + 'focus=1';
    } },
    ...(toggleSidebar ? [{ keys: '[', label: 'Collapse or expand the sidebar', run: toggleSidebar }] : []),
    { keys: 't', label: 'Next colour theme', run: () => {
      const cur = root.getAttribute('data-theme');
      const n = THEMES[(THEMES.indexOf(cur) + 1) % THEMES.length];
      setTheme(n);
      toast(n.charAt(0).toUpperCase() + n.slice(1) + ' theme', 'palette');
    } },
    { keys: '?', label: 'Show keyboard shortcuts', run: showKeys },
    { keys: 'Escape', label: 'Close a menu, dialog or the drawer' },
  ]);
  if (sb) {
    // `g` then a letter, as on GitHub and in Linear. Built from the shell's own
    // links ([data-nav-id]: the track tabs, the sidebar, the account menu), so
    // a key never points at a page this account cannot see. DP Ladder and Hard
    // are views of their tabs (PLAN-138), so theirs are derived from the tab.
    const links = {};
    document.querySelectorAll('[data-nav-id]').forEach((a) => { links[a.dataset.navId] = a.href; });
    const view = (id, v) => (links[id] ? `${links[id]}${links[id].includes('?') ? '&' : '?'}view=${v}` : null);
    links.dpladder = view('warmup', 'dpladder');
    links.hard = view('problems', 'hard');
    const GO = [['dashboard', 'd', 'Dashboard'], ['revision', 'r', 'Revision'], ['basics', 'b', 'Basics'], ['warmup', 'w', 'Warm-Up'],
      ['dpladder', 'l', 'DP Ladder'], ['problems', 'p', 'Problems'], ['hard', 'h', 'Hard'], ['rehearsal', 'i', 'Rehearsal'],
      ['grind', 'm', 'Grind'], ['foundations', 'f', 'Foundations'], ['patterns', 'n', 'Patterns'], ['algorithms', 'a', 'Algorithms'],
      ['log', 'o', 'Solve log'], ['profile', 'u', 'Profile'], ['settings', 's', 'Settings']];
    addKeys('Go to', GO.filter(([id]) => links[id]).map(([id, k, label]) => ({ keys: 'g ' + k, label, run: () => { location.href = links[id]; } })));
  }
  document.addEventListener('keydown', onKey);
})();
